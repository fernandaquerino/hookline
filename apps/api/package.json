{
  "name": "@hookline/api",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node --env-file-if-exists=../../.env dist/main.js\"",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@hookline/db": "workspace:*",
    "@hookline/shared": "workspace:*",
    "@hookline/signatures": "workspace:*",
    "@nestjs/common": "11.2.9",
    "@nestjs/core": "11.2.9",
    "@nestjs/platform-express": "11.2.9",
    "express": "5.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.9",
    "@swc/core": "1.16.22",
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.2",
    "tsc-watch": "7.2.1",
    "unplugin-swc": "2.0.0",
    "vitest": "3.2.7"
  }
}
