# Copy to .env and fill in. Never commit real values.

NODE_ENV=development

# PostgreSQL and Redis (docker-compose.yml provides both on these ports)
DATABASE_URL=postgresql://hookline:hookline@localhost:5432/hookline
REDIS_URL=redis://localhost:6379
# BullMQ key prefix shared by the API (health) and the dispatcher
QUEUE_PREFIX=hookline

# 32 random bytes, base64 encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
HOOKLINE_ENCRYPTION_KEY=replace-with-32-random-bytes-base64

# Admin password hash (scrypt). Generate with:
#   pnpm --filter @hookline/api hash-password 'your-password'
ADMIN_PASSWORD_HASH=replace-with-generated-hash

# Secret used to sign the session cookie (any long random string)
SESSION_SECRET=replace-with-a-long-random-string

# API
API_PORT=4000
# Base URL shown in the dashboard for ingest URLs (/in/:slug)
PUBLIC_INGEST_BASE_URL=http://localhost:4000

# Dashboard: where the Next.js server proxies /api requests
API_URL=http://localhost:4000

# Delivery behaviour
# Allow destinations on private, loopback and link-local addresses.
# Defaults to true only when NODE_ENV=development; set false for shared environments.
ALLOW_PRIVATE_DESTINATIONS=true
# Extra headers to redact before storage (comma separated). Authorization and Cookie are always redacted.
REDACT_HEADERS=x-api-key
# Retry backoff (full jitter): base and cap in milliseconds
RETRY_BASE_MS=2000
RETRY_CAP_MS=600000

# Retention
RETENTION_DAYS=7
